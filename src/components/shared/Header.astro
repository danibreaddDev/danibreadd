---
import { Icon, type AstroComponent } from "@lucide/astro";
interface Link {
  name: string;
  href: string;
  icon: AstroComponent;
}
interface Props {
  devName: string;
  links: Link[];
}
const { devName, links } = Astro.props;
---

<header class="py-5 px-5 text-white w-full font-primary">
  <div class="flex flex-row justify-between gap-2 items-center p-2">
    <div class="flex gap-2 items-center">
      <span class="text-3xl font-black">#</span>
      <a href="/" class="text-3xl font-black">{devName}</a>
    </div>
    {
      links.map((link) => {
        const Icon = link.icon;
        return (
          <a
            href={link.href}
            class="flex flex-row gap-2 items-center bg-white text-black px-5 py-3 rounded-full"
          >
            <span class="text-3xl font-black">{link.name}</span>
            <Icon size={18} stroke-width={1.5} />
          </a>
        );
      })
    }
  </div>
</header>
<style scoped>
  a {
    cursor: pointer;
    &:hover {
      text-decoration: underline dashed;
      text-underline-offset: 4px;
    }
  }
</style>
