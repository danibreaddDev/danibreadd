---
import ProjectList from "./ProjectList.astro";
import projects from "../../data/projects.json";
---

<div
    class="projects-container flex flex-col gap-2 relative overflow-hidden rounded-2xl p-4 -m-4"
>
    <div class="relative z-10 flex flex-col gap-2">
        <h2 class="text-3xl 2xl:text-5xl font-black">Proyectos</h2>
        <ProjectList projects={projects.projects} />
        <ProjectList projects={projects.landings} />
    </div>

    <div class="toto-shiny-container">
        <img
            src="/images/toto_shiny.png"
            class="toto-shiny-img w-full drop-shadow-lg"
            alt="Toto Shiny popup"
        />
        <div
            class="toto-shiny-dialog absolute z-50 pointer-events-none text-black text-[10px] 2xl:text-xs text-justify font-bold px-3 py-2 md:px-4 md:py-2 outline-[#D7D140] outline-4 outline-dashed bg-white drop-shadow-md"
        >
        </div>
    </div>
</div>

<script>
    document.addEventListener("astro:page-load", () => {
        const dialog = document.querySelector(".toto-shiny-dialog");
        const links = document.querySelectorAll(".project-link");

        if (!dialog) return;

        links.forEach((link) => {
            link.addEventListener("mouseenter", () => {
                const desc = link.getAttribute("data-desc");
                if (desc && desc !== "undefined") {
                    dialog.textContent = desc;
                    dialog.classList.add("show-dialog");
                }
            });
            link.addEventListener("mouseleave", () => {
                dialog.classList.remove("show-dialog");
            });
        });
    });
</script>

<style is:global>
    .toto-shiny-container {
        position: absolute;
        bottom: -200px;
        right: 0px;
        width: 100px;
        z-index: 50;
        opacity: 0;
        transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        pointer-events: none;
    }

    @media (min-width: 768px) {
        .toto-shiny-container {
            right: 10px;
        }
    }
    @media (min-width: 1536px) {
        .toto-shiny-container {
            width: 120px;
        }
    }
    @media (min-width: 1995px) {
        .toto-shiny-container {
            width: 200px;
        }
    }

    @keyframes wiggle {
        0% {
            transform: rotate(0deg);
        }
        25% {
            transform: rotate(-5deg) translateX(5px) rotateZ(10deg) scale(0.9);
        }
        50% {
            transform: rotate(0deg) translateX(-5px) rotateZ(-10deg) scale(1.1);
        }
        75% {
            transform: rotate(5deg) translateX(5px);
        }
        100% {
            transform: rotate(0deg);
        }
    }

    .projects-container:has(a:hover) .toto-shiny-container {
        bottom: -10px;
        opacity: 1;
    }

    .projects-container:has(a:hover) .toto-shiny-img {
        animation: wiggle 1s ease-in-out forwards 0.5s;
    }

    .toto-shiny-dialog {
        opacity: 0;
        background-color: white;
        width: 200px;
        transform: scale(0);
        color: black;
        bottom: 80%;
        right: 80%;
        transform-origin: bottom right;
        transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }

    .toto-shiny-dialog.show-dialog {
        opacity: 1;
        transform: scale(1);
    }
</style>
