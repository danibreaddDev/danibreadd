---
import { Instagram, Youtube, Github, Linkedin } from "@lucide/astro";
---

<section
  class="flex flex-col gap-3 relative overflow-hidden rounded-2xl p-4 text-[12px] 2xl:text-lg"
>
  <div class="flex flex-row flex-wrap gap-2 justify-end relative z-10">
    <a
      href="https://www.instagram.com/danibreadd/"
      target="_blank"
      class="social-link"
    >
      <Instagram size={20} />
      <span>@danibreadd</span>
    </a>
    <a
      href="https://www.threads.com/@danibreadd?hl=es"
      target="_blank"
      class="social-link"
    >
      <!-- Threads icon (SVG inline) -->
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="20"
        height="20"
        viewBox="0 0 192 192"
        fill="currentColor"
        aria-hidden="true"
      >
        <path
          d="M141.537 88.988a66.667 66.667 0 0 0-2.518-1.143c-1.482-27.307-16.403-42.94-41.457-43.1h-.34c-14.986 0-27.449 6.396-35.12 18.036l13.779 9.452c5.73-8.695 14.724-10.548 21.348-10.548h.229c8.249.053 14.474 2.452 18.503 7.129 2.932 3.405 4.893 8.111 5.864 14.05-7.314-1.243-15.224-1.626-23.68-1.14-23.82 1.371-39.134 15.264-38.105 34.568.522 9.792 5.4 18.216 13.735 23.719 7.047 4.652 16.124 6.927 25.557 6.412 12.458-.683 22.231-5.436 29.049-14.127 5.178-6.6 8.453-15.153 9.899-25.93 5.937 3.583 10.337 8.298 12.767 13.966 4.132 9.635 4.373 25.468-8.546 38.376-11.319 11.308-24.925 16.2-45.488 16.351-22.809-.169-40.06-7.484-51.275-21.742C35.236 139.966 29.808 120.682 29.605 96c.203-24.682 5.63-43.966 16.133-57.317C56.954 24.425 74.204 17.11 97.013 16.94c22.975.17 40.526 7.52 52.171 21.847 5.71 7.026 10.015 15.86 12.853 26.162l16.147-4.308c-3.44-12.68-8.853-23.606-16.219-32.668C147.036 9.607 125.202.195 97.07 0h-.113C68.882.195 47.292 9.643 32.788 28.054 19.882 44.512 13.223 67.625 13.001 96v.027c.222 28.375 6.88 51.488 19.787 67.946C47.292 182.358 68.882 191.805 96.957 192h.113c24.96-.173 42.554-6.708 57.048-21.189 18.963-18.945 18.392-42.692 12.142-57.27-4.484-10.454-13.033-18.945-24.723-24.553ZM98.44 129.507c-10.44.588-21.286-4.098-21.82-14.135-.397-7.442 5.296-15.746 22.461-16.735 1.966-.113 3.895-.169 5.79-.169 6.235 0 12.068.606 17.371 1.765-1.978 24.702-13.574 28.713-23.802 29.274Z"
        ></path>
      </svg>
      <span>@danibreadd</span>
    </a>
    <a
      href="https://www.youtube.com/@danibreadd"
      target="_blank"
      class="social-link"
    >
      <Youtube size={20} />
      <span>Daniel Pamblanco Mestre</span>
    </a>
    <a
      href="https://github.com/danibreaddDev"
      target="_blank"
      class="social-link"
    >
      <Github size={20} />
      <span>@danibreadddev</span>
    </a>
    <a
      href="https://www.linkedin.com/in/dani-pamblanco/"
      target="_blank"
      class="social-link"
    >
      <Linkedin size={20} />
      <span>Daniel Pamblanco Mestre</span>
    </a>
    <a
      href="https://ko-fi.com/danibreadddev"
      target="_blank"
      class="social-link"
    >
      <!-- Ko-fi icon (SVG inline) -->
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="20"
        height="20"
        viewBox="0 0 24 24"
        fill="currentColor"
        aria-hidden="true"
      >
        <path
          d="M23.881 8.948c-.773-4.085-4.859-4.593-4.859-4.593H.723c-.604 0-.679.798-.679.798s-.082 7.324-.022 11.822c.164 2.424 2.586 2.672 2.586 2.672s8.267-.023 11.966-.049c2.438-.426 2.683-2.566 2.658-3.734 4.352.24 7.422-2.831 6.649-6.916zm-11.062 3.511c-1.246 1.453-4.011 3.976-4.011 3.976s-.121.119-.31.023c-.076-.057-.108-.09-.108-.09-.443-.441-3.368-3.049-4.034-3.954-.709-.965-1.041-2.7-.091-3.71.951-1.01 3.005-1.086 4.363.407 0 0 1.565-1.782 3.468-.963 1.904.82 1.832 3.011.723 4.311zm6.173.478c-.928.116-1.682.028-1.682.028V7.284h1.77s1.971.551 1.971 2.638c0 1.913-.985 2.667-2.059 3.015z"
        ></path>
      </svg>
      <span>danibreadd</span>
    </a>
  </div>

  <img
    src="/images/toto.png"
    class="toto-popup drop-shadow-lg"
    alt="Toto popup"
  />
</section>
<style>
  .social-link {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    cursor: pointer;
    text-decoration: none;
    transition: color 0.2s;
  }
  .social-link:hover {
    text-decoration: underline dashed;
    text-underline-offset: 4px;
  }

  .toto-popup {
    position: absolute;
    bottom: -200px;
    left: 0px;
    z-index: 0;
    opacity: 0;
    transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    pointer-events: none;
  }

  @media (min-width: 768px) {
    .toto-popup {
      right: 10px;
      width: 100px;
    }

    @media (min-width: 1536px) {
      .toto-popup {
        width: 120px;
      }
    }
  }

  @keyframes wiggle-flipped {
    0% {
      transform: rotate(0deg);
    }
    25% {
      transform: rotate(-5deg) rotateZ(10deg) translateX(5px) scale(0.9);
    }
    50% {
      transform: rotate(0deg) rotateZ(-10deg) translateX(-5px) scale(1.1);
    }
    75% {
      transform: rotate(5deg) translateX(5px);
    }
    100% {
      transform: rotate(0deg);
    }
  }

  section:has(a:hover) .toto-popup {
    bottom: -10px;
    opacity: 1;
    animation: wiggle-flipped 1.5s ease-in-out forwards 0.3s;
  }
</style>
