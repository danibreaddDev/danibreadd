---
interface Props {
  projects: { title: string; url: string; description?: string }[];
}
const { projects } = Astro.props;
---

<div class="flex flex-row flex-wrap items-center gap-5">
  {
    projects.map((project) => (
      <a
        href={project.url}
        target="_blank"
        class="text-justify text-[12px] 2xl:text-lg project-link group"
        data-desc={project.description}
      >
        {project.title}
      </a>
    ))
  }
</div>
<style scoped>
  .project-link {
    cursor: pointer;
    text-decoration: none;
  }
  .project-link:hover {
    text-decoration: underline dashed;
    text-underline-offset: 4px;
  }
</style>
