---
import BaseLayout from "../layouts/baseLayout.astro";
import Header from "../components/shared/Header.astro";
import { Video } from "@lucide/astro";
---

<BaseLayout title="Daniel Pamblanco Mestre | Desarrollador Web">
  <div class="h-1/2 w-full">
    <svg
      width="100%"
      height="100%"
      viewBox="0 0 100 25"
      preserveAspectRatio="none"
      class="fill-white"
    >
      <text
        x="0"
        y="21"
        font-weight="900"
        font-size="24"
        textLength="100"
        lengthAdjust="spacingAndGlyphs"
        class="uppercase">DANIBREADD</text
      >
    </svg>
  </div>
  <div class="grid grid-cols-1 md:grid-cols-3 h-full">
    <div
      class="col-span-1 h-full bg-cover bg-center md:bg-bottom bg-no-repeat bg-[url('/images/portada.jpg')]"
    >
    </div>
    <div
      class="col-span-2 grid grid-cols-1 md:grid-cols-2 gap-2 h-full uppercase"
    >
      <div class="flex flex-col justify-between text-white p-5">
        <div>Musica</div>
        <div class="flex flex-col gap-2">
          <h1 class="text-5xl font-black">Sobre mi</h1>
          <hr />
          <p class="text-justify">
            Me llamo Dani, soy programador Frontend. Me mola el mundillo de la
            música, los videjuegos y sobre todo hacer paginas web.
          </p>
        </div>
      </div>
      <div class="text-white flex flex-col justify-between gap-5 p-5">
        <h1 class="text-5xl font-black">Redes sociales</h1>
        <div class="bg-white text-black">Años de experiencia</div>
      </div>
    </div>
  </div>
</BaseLayout>
