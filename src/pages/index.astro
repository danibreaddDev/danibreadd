---
import BaseLayout from "../layouts/baseLayout.astro";
import Header from "../components/shared/Header.astro";
import Socials from "../components/home/Socials.astro";
import YearsExperience from "../components/home/YearsExperience.astro";
import Presentation from "../components/home/Presentation.astro";
import ProjectsCard from "../components/home/ProjectsCard.astro";
---

<BaseLayout title="Daniel Pamblanco Mestre | Desarrollador Web">
  <div class="h-1/2 w-full">
    <svg
      width="100%"
      height="100%"
      viewBox="0 0 100 25"
      preserveAspectRatio="none"
      class="fill-[#D7D140]"
    >
      <text
        x="0"
        y="21"
        font-weight="900"
        font-size="24"
        textLength="100"
        lengthAdjust="spacingAndGlyphs"
        class="uppercase">DANIBREADD</text
      >
    </svg>
  </div>
  <div class="grid grid-cols-1 md:grid-cols-3 gap-2 h-full">
    <div
      class="col-span-1 h-64 md:h-full bg-cover bg-center md:bg-bottom bg-no-repeat bg-[url('/images/portada.jpg')]"
    >
    </div>
    <div
      class="col-span-2 grid grid-cols-1 lg:grid-cols-2 gap-5 h-full uppercase"
    >
      <div class="grid grid-cols-1 md:gap-2 gap-5 text-white">
        <Presentation
          title="Sobre mi"
          description="Soy Dani,programador Frontend y llevo unos años trabajando en el mundo de la programación web. Fuera del curro tampoco paro, me mola codear en mis ratos libres y no me callo ni bajo el agua, de ahi mi pokemon favorito, totodile :)."
        />
        <ProjectsCard />
      </div>
      <div class="text-white grid grid-cols-1">
        <Socials />
        <YearsExperience years={2} href="#sobre-mi" />
      </div>
    </div>
  </div>
</BaseLayout>
