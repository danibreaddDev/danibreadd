---
import BaseLayout from "../../layouts/baseLayout.astro";
import videos from "../../data/videos.json";
const videosList = videos.sort((a, b) => b.episode - a.episode);
---

<BaseLayout title="Documentando mi rutina | Daniel Pamblanco Mestre">
  <h1 class="text-2xl leading-8 text-gray-800">Documentando mi rutina</h1>
  <div class="grid grid-cols-1 gap-5">
    {
      videosList.map((video) => (
        <a href={video.href} target="_blank" class="group">
          <div class="group flex hover:bg-gray-50 rounded-2xl items-center gap-4">
            <img
              src={`/images/episodes/ep-${video.episode}.jpg`}
              alt="img"
              class="w-40 object-cover aspect-video flex-shrink-0"
            />
            <div class="font-semibold group-hover:font-extrabold group-hover:translate-x-2 transition-all duration-150 ease-in-out">
              <p class="text-sm text-gray-500 ">Episodio {video.episode}</p>
              <p class="group-hover:text-gray-950 text-gray-700">
                {video.title}
              </p>
            </div>
          </div>
        </a>
      ))
    }
  </div>
</BaseLayout>
