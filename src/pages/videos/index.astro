---
import BaseLayout from "../../layouts/baseLayout.astro";
import videos from "../../data/videos.json";
const videosList = videos.sort((a, b) => b.episode - a.episode);
import { ArrowLeft } from "@lucide/astro/icons";
---

<BaseLayout title="Documentando mi rutina | Daniel Pamblanco Mestre">
  <a
    href="/"
    class="absolute px-5 py-2 rounded-full uppercase -top-6 text-sm 2xl:text-3xl self-center flex flex-row items-center gap-2 bg-white outline-4 outline-dashed"
  >
    <ArrowLeft size={32} /><span class="font-black">Volver</span></a
  >
  <h1
    class="mt-32 text-3xl 2xl:text-6xl leading-8 uppercase text-[#D7D140] font-black"
  >
    Documentando mi rutina
  </h1>
  <div
    class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 mt-12 gap-5 uppercase text-white"
  >
    {
      videosList.map((video) => (
        <a href={video.href} target="_blank" class="group">
          <div class="group flex hover:bg-gray-50 rounded-2xl items-center gap-4">
            <img
              src={`/images/episodes/ep-${video.episode}.jpg`}
              alt="img"
              class="w-40 object-cover aspect-video flex-shrink-0"
            />
            <div class="font-semibold group-hover:font-extrabold group-hover:translate-x-2 transition-all duration-150 ease-in-out">
              <p class="text-sm group-hover:text-gray-900">
                Episodio {video.episode}
              </p>
              <p class="group-hover:text-gray-950">{video.title}</p>
            </div>
          </div>
        </a>
      ))
    }
  </div>
</BaseLayout>
