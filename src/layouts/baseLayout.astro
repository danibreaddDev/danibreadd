---
import "../styles/global.css";
import CommonHead from "../components/shared/CommonHead.astro";
import { Video } from "@lucide/astro/icons";
interface Props {
  title: string;
}
const { title } = Astro.props;
---

<html lang="es" transition:animate="fade">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="Daniel Pamblanco Mestre es un desarrollador web especializado en Frontend Explora mis proyectos y trabajos más recientes, aqui comparto tambien momentos y recomendaciones de mi dia a dia."
    />
    <meta
      name="keywords"
      content="Daniel Pamblanco Mestre, desarrollador web, portfolio, proyectos, FrontEnd, Gym, Motivación."
    />
    <meta property="og:url" content="https://www.danibreadd.com/" />
    <CommonHead />
    <title>{title}</title>
  </head>
  <body>
    <main class="min-h-screen font-tertiary overflow-hidden">
      <div class="relative flex flex-col justify-center items-center h-screen">
        <div
          class="relative w-full md:max-w-[80%] min-w-[95%] md:min-w-[80%] h-[85vh]"
        >
          <a
            href="/videos"
            class="absolute px-5 py-2 font-black flex flex-row items-center gap-2 text-sm bg-white rounded-full 2xl:text-3xl uppercase right-2 top-0 z-20 text-black md:-right-8 outline-4 outline-dashed rotate-12"
            ><Video size={64} /><span>videos</span></a
          >
          <!-- Imágenes en las esquinas -->
          <img
            src="/images/cookie_for_totodile.png"
            class="absolute -top-8 -left-2 md:-top-26 md:-left-20 w-20 md:w-64 z-20 pointer-events-none drop-shadow-lg"
            alt="Totodile Cookie"
          />
          <img
            src="/images/mudkip_swag.png"
            class="absolute -bottom-8 -right-6 md:-bottom-20 md:-right-32 w-20 md:w-64 z-20 pointer-events-none drop-shadow-lg"
            alt="Mudkip Swag"
          />

          <!-- Contenedor Negro -->
          <div
            class="w-full h-full flex flex-col border-gray-300 md:rounded-2xl bg-[#111111] p-6 overflow-y-auto overflow-x-hidden"
          >
            <slot />
          </div>
        </div>
      </div>
    </main>
  </body>
</html>
